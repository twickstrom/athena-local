{
  "name": "athena-local",
  "version": "0.0.0",
  "description": "Local AWS Athena-compatible development server backed by Trino.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": "Tim Wickstrom",
  "homepage": "https://github.com/twickstrom/athena-local#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twickstrom/athena-local.git"
  },
  "bugs": {
    "url": "https://github.com/twickstrom/athena-local/issues"
  },
  "keywords": [
    "athena",
    "aws",
    "bun",
    "trino",
    "minio",
    "local-development"
  ],
  "bin": {
    "athena-local": "./src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "bun run scripts/check-format.ts --write",
    "format:check": "bun run scripts/check-format.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:protocol": "bun test test/protocol",
    "test:sqlite": "bun test test/sqlite",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e",
    "test:docker": "bun test test/runtime/docker",
    "test:apple-container": "bun test test/runtime/apple-container",
    "test:aws": "bun test test/aws",
    "test:package": "bun run scripts/package-smoke.ts",
    "test:release": "bun run typecheck && bun test && bun run test:package",
    "infra:up": "bun run src/cli.ts start",
    "infra:down": "bun run src/cli.ts stop",
    "infra:reset": "bun run src/cli.ts reset",
    "infra:status": "bun run src/cli.ts status",
    "seed": "bun run src/cli.ts seed"
  },
  "devDependencies": {
    "@aws-sdk/client-athena": "^3.1071.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
